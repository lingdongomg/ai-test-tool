FROM python:3.13-slim

WORKDIR /app

# Install dependencies first for layer caching
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application source
COPY ai_test_tool/ ai_test_tool/
COPY server.py .

# 创建挂载目录，使用宽松权限以兼容 volume 挂载
RUN mkdir -p /app/data /app/logs /app/uploads/logs \
    && chmod -R 777 /app/data /app/logs /app/uploads

# 安全：使用非 root 用户运行
RUN addgroup --system appgroup && adduser --system --ingroup appgroup appuser \
    && chown -R appuser:appgroup /app

USER appuser

EXPOSE 8000

CMD ["uvicorn", "ai_test_tool.api:create_app", "--host", "0.0.0.0", "--port", "8000", "--factory"]
